# Server-side only — never prefix these with EXPO_PUBLIC_.
# Get one at https://e2b.dev (free tier available)
E2B_API_KEY=

# Used by opencode inside the sandbox
OPENAI_API_KEY=

# Optional. opencode model identifier in <provider>/<model> form.
# Defaults to openai/gpt-5. Examples: openai/gpt-5, openai/gpt-5-mini, openai/gpt-4o.
OPENCODE_MODEL=openai/gpt-5

# Optional. Used by the sandbox GitHub CLI (`gh`) when publishing generated apps.
# A classic PAT or fine-grained token with repository creation/push permissions works.
GH_TOKEN=
